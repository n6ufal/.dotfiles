{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/User/.config/fastfetch/virus.txt"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ECEFF4",
      "title": "#81A1C1"
    },
    "key": {
      "type": "icon"
    }
  },
  "modules": [
    {
      "type": "title"
    },
    "os",
    "host",
    "shell",
    "display",
    "cpu",
    "uptime",
    "memory",
    "battery",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
